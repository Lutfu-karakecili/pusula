# Bu dosyayı ".env" olarak kopyalayın ve gerçek değerlerinizi girin.
# .env dosyası ASLA git'e commit edilmemeli (.gitignore'da zaten tanımlı).

# === Supabase ===
# Dashboard > Settings > API içinden alın
VITE_SUPABASE_URL=https://projeniz.supabase.co
VITE_SUPABASE_ANON_KEY=buraya_anon_public_key_yapistirin

# ÖNEMLİ: service_role key'i BURAYA VEYA HERHANGİ BİR FRONTEND
# DOSYASINA ASLA YAZMAYIN. O key sadece backend/sunucu tarafında
# kullanılır ve RLS korumasını tamamen bypass eder.

# === Cloudflare Turnstile ===
# Cloudflare Dashboard > Turnstile > Site Key
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA

# === Sentry Hata Takibi ===
# sentry.io > Settings > Client Keys (DSN)
VITE_SENTRY_DSN=https://ornekPublicKey@o0.ingest.sentry.io/0
